PORT=3000

# Cấu hình kết nối SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrong@Password123
DB_NAME=RapChieuPhimDB
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Chế độ hoạt động: 
# - 'sqlserver': Kết nối trực tiếp SQL Server thật để chạy Stored Procedure
# - 'simulation': Chạy mô phỏng thời gian thực (hữu ích khi đi thuyết trình / máy không cài SQL Server)
APP_MODE=simulation
